{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "universal-db-mcp": {
      "command": "npx",
      "args": [
        "--yes",
        "universal-db-mcp",
        "--type",
        "mysql",
        "--host",
        "localhost",
        "--port",
        "3306",
        "--user",
        "root",
        "--password",
        "your_password",
        "--database",
        "your_database"
      ]
    }
  }
}
