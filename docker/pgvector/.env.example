# 复制为 .env 后修改：cp .env.example .env  (Linux/macOS)
# 或：Copy-Item .env.example .env  (Windows PowerShell)

# 宿主机映射端口
PGVECTOR_HOST_PORT=5433

POSTGRES_DB=quickboot_vector
POSTGRES_USER=vector
POSTGRES_PASSWORD=vector

# 与 quickboot application-dev.yml 中 qc.knowledge.vector-datasource 保持一致
# url: jdbc:postgresql://127.0.0.1:5433/quickboot_vector
