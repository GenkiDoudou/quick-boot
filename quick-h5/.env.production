# 生产 H5（同域 Nginx：静态 /h5/，API /prod-api/）
# 键名两侧勿加空格；值不要用引号包裹；真实 OAuth 密钥用 Jenkins Credentials 注入，勿提交生产密钥

VITE_APP_BASE_API=/prod-api
# 非 H5（小程序等）直连后端时再改；H5 生产以 VITE_APP_BASE_API 为准
VITE_APP_BASE_API_NATIVE=https://CHANGE_ME_HOST/prod-api

VITE_OAUTH_CLIENT_ID=quick-h5
VITE_OAUTH_CLIENT_SECRET=quick-h5-secret

VITE_APP_LITE_RUM_ENABLED=true
VITE_APP_LITE_RUM_APP_ID=quick-h5
