# 开发环境（可提交示例值；生产密钥勿入库）
# H5：走 Vite 代理 /dev-api（见 vite.config.ts）
# 小程序等非 H5：使用 VITE_APP_BASE_API_NATIVE
VITE_APP_BASE_API=/dev-api
VITE_APP_BASE_API_NATIVE=http://127.0.0.1:9993
VITE_OAUTH_CLIENT_ID=quick-h5
VITE_OAUTH_CLIENT_SECRET=quick-h5-secret
VITE_APP_LITE_RUM_ENABLED=true
VITE_APP_LITE_RUM_APP_ID=quick-h5
