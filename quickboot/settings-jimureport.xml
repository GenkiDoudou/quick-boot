<?xml version="1.0" encoding="UTF-8"?>
<!--
  积木报表依赖解析用 settings（解决 html2image / tinypinyin 在阿里云镜像下找不到的问题）。

  用法（在 quickboot 目录）：
    mvn -s settings-jimureport.xml -pl quickboot-report,quickboot-web -am compile

  IDE：Settings → Maven → User settings file 指向本文件，并关闭 Work offline。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">

    <offline>false</offline>

    <mirrors>
        <!-- 关键：镜像排除 jeecg，否则 html2image 永远走阿里云而 404 -->
        <mirror>
            <id>aliyun-public</id>
            <mirrorOf>*,!jeecg</mirrorOf>
            <name>Aliyun Public</name>
            <url>https://maven.aliyun.com/repository/public</url>
        </mirror>
    </mirrors>

    <profiles>
        <profile>
            <id>jimureport-repos</id>
            <repositories>
                <repository>
                    <id>jeecg</id>
                    <name>Jeecg Maven</name>
                    <url>https://maven.jeecg.org/nexus/content/repositories/jeecg</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
                <repository>
                    <id>central</id>
                    <name>Maven Central</name>
                    <url>https://repo.maven.apache.org/maven2</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>jimureport-repos</activeProfile>
    </activeProfiles>
</settings>
