# 复制为部署目录下的 .env.properties 后填写真实值（与 jar、app.sh 同目录）。
# 勿将含真实密码的文件提交到 Git。
# Spring 通过 application.yml 的 spring.config.import: optional:file:./.env.properties 加载。

# 数据库：仅主机库名部分，不要带 ? 查询参数（查询串由 application-prod.yml 拼接）
DB_URL=jdbc:mariadb://127.0.0.1:3306/quickboot
DB_USERNAME=root
DB_PASSWORD=change_me

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Jenkins 发布成功回调鉴权（与 Job 参数 DEPLOY_CALLBACK_TOKEN 一致）
DEPLOY_CALLBACK_TOKEN=change_me_long_random
