# 生产环境配置（键名两侧勿加空格；值不要用引号包裹）
VITE_APP_ENV=production

VITE_APP_TITLE=QuickBoot管理系统
VITE_APP_LOGIN_TITLE=QuickBoot管理系统
VITE_APP_COPYRIGHT=Copyright © 2024 QuickBoot
VITE_APP_LOADING_TEXT=正在加载中...
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=QuickBoot快速开发平台

# 与 Nginx location /prod-api/ 一致；须 proxy_pass 到后端时去掉 /prod-api 前缀
VITE_APP_BASE_API=http://192.168.50.105:81/prod-api

# Client HMAC（须与 sys_oauth_client：client_id=quick-ui、client_secret 明文一致）
VITE_APP_CLIENT_ID=quick-ui
VITE_APP_CLIENT_SIGN_KEY=0123456789abcdef0123456789abcdef

VITE_APP_MONITOR_ENABLED=true
VITE_APP_MONITOR_MAX_KEEP=40
VITE_APP_MONITOR_INTERVAL=10000
VITE_APP_MONITOR_SLOW_API_MS=3000

VITE_BUILD_COMPRESS=gzip
