# 开发环境（可提交示例值；生产密钥勿入库）
VITE_APP_TITLE=Quick Boot 管理系统
VITE_APP_LOGIN_TITLE=Quick Boot 后台管理系统
VITE_APP_COPYRIGHT=Copyright © 2024 Quick Boot All Rights Reserved.
VITE_APP_LOADING_TEXT=正在加载系统资源，请耐心等待
VITE_APP_BASE_API=/dev-api
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=基于 Spring Boot + Vue 3 的快速开发平台

# 登录 / 无 JWT 请求用的 OAuth 客户端（与 sys_oauth_client 种子一致；勿用旧 HMAC 的 CLIENT_SIGN_KEY）
VITE_OAUTH_CLIENT_ID=quick-ui
VITE_OAUTH_CLIENT_SECRET=quick-ui-secret

# 前端用户行为监控（全局插件，批次上报 /monitor/clientTrack/report）
VITE_APP_MONITOR_ENABLED=true
VITE_APP_MONITOR_MAX_KEEP=40
VITE_APP_MONITOR_INTERVAL=10000
VITE_APP_MONITOR_IDLE_MS=3000
VITE_APP_MONITOR_SLOW_API_MS=3000
