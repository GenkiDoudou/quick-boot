# 可选：仍可用 SPRING_CONFIG_ADDITIONAL_LOCATION 覆盖大段 yml。
# 推荐优先用同目录 .env.properties（见 .env.properties.example）提供 DB/Redis。
# 复制到目标机时勿提交真实密码。

server:
  port: 9993

# 关闭本地开发用嵌入式组件（matchIfMissing 时生产必须显式关闭；application-prod.yml 已默认关闭）
qc:
  dev:
    embedded-mariadb:
      enabled: false
    embedded-redis:
      enabled: false
  security:
    firewall:
      cors:
        enabled: false
  oauth:
    enable: true
    key: QuickBootOAuth1
  jimu:
    base-url: https://CHANGE_ME_HOST
  file:
    view-url-base: https://CHANGE_ME_HOST/prod-api/system/file/view

logging:
  file:
    name: /opt/quickboot/logs/quickboot.log
