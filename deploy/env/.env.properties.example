# 复制到目标机部署目录：与 jar、app.sh 同级，命名为 .env.properties
# 应用通过 spring.config.import: optional:file:./.env.properties 加载。
# 勿提交真实密码到 Git。完整说明见本目录 README.md。

DB_URL=jdbc:mariadb://127.0.0.1:3306/quickboot
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Jenkins 发布成功回调鉴权（与 Job 参数 DEPLOY_CALLBACK_TOKEN 一致）
DEPLOY_CALLBACK_TOKEN=change_me_long_random

# 公网后端根（须含 /prod-api，与 Nginx 及积木 customPrePath 一致）
QC_JIMU_BASE_URL=https://CHANGE_ME_HOST/prod-api
# 积木静态资源前缀（官方 customPrePath）；与上式 /prod-api 对齐
JIMU_CUSTOM_PRE_PATH=/prod-api
# 文件预览 URL 前缀
QC_FILE_VIEW_URL_BASE=https://CHANGE_ME_HOST/prod-api/system/file/view
