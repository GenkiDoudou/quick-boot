/**
 * VitePress 文档站静态发布 Pipeline。
 *
 * DEPLOY_HOSTS = 目标机 IP/域名；Jenkins SSH 凭据 ID 与主机名相同（同 Jenkinsfile.quick-ui）。
 * 参数：已有 params 则沿用；全部缺失时写入默认参数并提示再构建（不读 rawBuild）。
 * 产物目录：docs/.vitepress/dist（VitePress 1.x 默认 outDir）。
 */
pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  stages {
    stage('Resolve') {
      steps {
        script {
          ensureJobParameters()
          validateJobParameters()
          splitHosts(env.EFFECTIVE_DEPLOY_HOSTS).each { host ->
            echo "ENV=${env.EFFECTIVE_ENV} operate=${env.EFFECTIVE_OPERATE} host=${host} cred=${host} user=${env.DEPLOY_USER_RESOLVED} DEPLOY_DIR=${env.EFFECTIVE_DEPLOY_DIR}"
          }
        }
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build') {
      when { expression { env.EFFECTIVE_OPERATE == 'deploy' } }
      steps {
        dir('docs') {
          sh '''
            set -e
            # 与文档站/前端 pnpm@9 对齐；避免 corepack 拉到 pnpm11（需 Node≥22）
            export CI=true
            corepack enable || true
            corepack prepare pnpm@9.0.0 --activate
            pnpm --version
            pnpm install --frozen-lockfile
            pnpm build
          '''
        }
      }
    }

    stage('Archive') {
      when { expression { env.EFFECTIVE_OPERATE == 'deploy' } }
      steps {
        archiveArtifacts artifacts: 'docs/.vitepress/dist/**', fingerprint: true
      }
    }

    stage('Deploy') {
      when { expression { env.EFFECTIVE_OPERATE == 'deploy' } }
      steps {
        script {
          def deployDir = env.EFFECTIVE_DEPLOY_DIR
          withEachHost { host, user, sshOpts ->
            echo "部署 docs 到 ${host}:${deployDir} (凭据 ${host})"
            sh """
              set -e
              ssh ${sshOpts} ${user}@${host} "mkdir -p '${deployDir}'"
              rsync -az --delete -e "ssh ${sshOpts}" \
                docs/.vitepress/dist/ ${user}@${host}:'${deployDir}/'
              # 静态文件无需 reload；改 Nginx conf 时请在目标机手工 nginx -t && reload
            """
          }
        }
      }
    }

    stage('Rollback') {
      when { expression { env.EFFECTIVE_OPERATE == 'rollback' } }
      steps {
        error('docs 静态资源暂不支持 rollback，请重新 deploy 指定分支/产物')
      }
    }

    stage('Smoke') {
      steps {
        script {
          if (env.EFFECTIVE_SKIP_SMOKE == 'true') {
            echo 'SKIP_SMOKE=true，跳过冒烟'
            return
          }
          def base = env.EFFECTIVE_SMOKE_BASE_URL?.trim()
          if (base) {
            base = base.replaceAll(/\/$/, '')
            sh "curl -sfI --retry 5 --retry-delay 2 '${base}/'"
            return
          }
          withEachHost { host, user, sshOpts ->
            echo "健康检查 ${host} http://127.0.0.1/docs/"
            sh """
              set -e
              ssh ${sshOpts} ${user}@${host} \
                'curl -sfI --retry 5 --retry-delay 2 http://127.0.0.1/docs/'
            """
          }
        }
      }
    }
  }

  post {
    success {
      echo "✅ docs ${env.EFFECTIVE_OPERATE} 成功 ENV=${env.EFFECTIVE_ENV} BUILD=${env.BUILD_NUMBER}"
    }
    failure {
      echo "❌ docs ${env.EFFECTIVE_OPERATE} 失败 ENV=${env.EFFECTIVE_ENV} BUILD=${env.BUILD_NUMBER} 日志=${env.BUILD_URL}"
    }
  }
}

def requiredJobParamNames() {
  return ['ENV', 'BRANCH', 'DEPLOY_HOSTS', 'DEPLOY_DIR', 'operate']
}

def defaultJobParameters() {
  return [
    choice(name: 'ENV', choices: ['test', 'prod', 'dev'], description: '部署环境标识'),
    string(name: 'BRANCH', defaultValue: 'main', description: 'Git 分支'),
    string(name: 'DEPLOY_HOSTS', defaultValue: '', description: '目标机 IP/域名，逗号分隔；凭据 ID 须与主机名相同'),
    string(name: 'DEPLOY_DIR', defaultValue: '/opt/quickboot/www/docs', description: '目标机静态目录'),
    choice(name: 'operate', choices: ['deploy', 'rollback'], description: 'deploy=发布；rollback 暂不支持'),
    booleanParam(name: 'SKIP_SMOKE', defaultValue: false, description: '跳过健康检查'),
    string(name: 'SMOKE_BASE_URL', defaultValue: '', description: '公网 docs URL（如 https://example.com/docs）；空则 SSH 打本机 Nginx /docs/'),
  ]
}

def ensureJobParameters() {
  def required = requiredJobParamNames()
  def missing = required.findAll { !params.containsKey(it) }

  if (missing.isEmpty()) {
    echo '使用当前构建参数（不覆盖 Job Configure）'
    return
  }

  if (missing.size() < required.size()) {
    error("Job 缺少部分参数: ${missing.join(', ')}。请在 Configure 手工添加；或删除全部参数后重新构建以自动初始化。见 deploy/env/README.md")
  }

  echo 'Job 尚未带入必需参数，正在写入默认参数定义（仅此一次）…'
  properties([parameters(defaultJobParameters())])
  error('已在 Job 中写入默认参数。请再次点击「Build with Parameters」开始构建。')
}

def validateJobParameters() {
  def missing = requiredJobParamNames().findAll { !params.containsKey(it) }
  if (!missing.isEmpty()) {
    error("当前构建未带入参数: ${missing.join(', ')}。请使用「Build with Parameters」。")
  }

  env.EFFECTIVE_ENV = paramString('ENV', 'test')
  env.EFFECTIVE_BRANCH = paramString('BRANCH', 'main')
  env.EFFECTIVE_DEPLOY_HOSTS = paramString('DEPLOY_HOSTS', '')
  env.EFFECTIVE_DEPLOY_DIR = paramString('DEPLOY_DIR', '/opt/quickboot/www/docs')
  env.EFFECTIVE_OPERATE = paramString('operate', 'deploy')
  env.EFFECTIVE_SKIP_SMOKE = paramBool('SKIP_SMOKE', false)
  env.EFFECTIVE_SMOKE_BASE_URL = paramString('SMOKE_BASE_URL', '')
  env.DEPLOY_USER_RESOLVED = env.QUICKBOOT_SSH_USER?.trim() ?: 'root'

  def hosts = splitHosts(env.EFFECTIVE_DEPLOY_HOSTS)
  if (!hosts) {
    error('DEPLOY_HOSTS 不能为空（填写目标机 IP/域名，且 Jenkins 凭据 ID 与之相同）')
  }
  hosts.each { host ->
    if (host ==~ /^\d+$/) {
      error("DEPLOY_HOSTS 项「${host}」无效。请填完整 IP/域名，例如 192.168.50.105")
    }
  }
}

def paramString(String name, String fallback) {
  if (!params.containsKey(name)) {
    return fallback
  }
  def v = params[name]?.toString()?.trim()
  return v ?: fallback
}

def paramBool(String name, boolean fallback) {
  if (!params.containsKey(name)) {
    return fallback.toString()
  }
  return params[name]?.toString()
}

def splitHosts(String raw) {
  return (raw ?: '').split(/[,;\s]+/).findAll { it }
}

def withEachHost(Closure body) {
  def sshOpts = env.QUICKBOOT_SSH_OPTS?.trim() ?: '-o StrictHostKeyChecking=no'
  def user = env.DEPLOY_USER_RESOLVED
  splitHosts(env.EFFECTIVE_DEPLOY_HOSTS).each { host ->
    echo "SSH 目标=${host} 用户=${user} 凭据 ID=${host}"
    sshagent(credentials: [host]) {
      body(host, user, sshOpts)
    }
  }
}
