/**
 * quickboot 后端发布 Pipeline。
 *
 * 参数不在此文件声明（避免每次构建用 Jenkinsfile 默认值覆盖 Job Configure 里的配置）。
 * 请在 Jenkins Job → Configure → 「参数化构建过程」中手工添加，见 deploy/env/README.md。
 *
 * SSH 凭据：DEPLOY_CRED_ID 非空则全部主机共用；否则每台用 DEPLOY_HOSTS 同名 Credentials ID。
 */
pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  tools {
    maven 'mvn'
  }

  environment {
    JAR_NAME = 'quickboot-app.jar'
    port = '9993'
    TARGET_DIR = 'quickboot/quickboot-app/target'
  }

  stages {
    stage('Resolve') {
      steps {
        script {
          validateJobParameters()
          def hosts = splitHosts(env.EFFECTIVE_DEPLOY_HOSTS)
          env.DEPLOY_HOST_LIST = hosts.join(',')
          env.DEPLOY_USER_RESOLVED = env.QUICKBOOT_SSH_USER?.trim() ?: 'quickboot'
          def credOverride = env.EFFECTIVE_DEPLOY_CRED_ID
          if (credOverride) {
            echo "ENV=${env.EFFECTIVE_ENV} operate=${env.EFFECTIVE_OPERATE} hosts=${env.DEPLOY_HOST_LIST} cred(共用)=${credOverride} user=${env.DEPLOY_USER_RESOLVED} DEPLOY_DIR=${env.EFFECTIVE_DEPLOY_DIR}"
          } else {
            def mapping = hosts.collect { h -> "${h}->${h}" }.join(', ')
            echo "ENV=${env.EFFECTIVE_ENV} operate=${env.EFFECTIVE_OPERATE} hosts=${env.DEPLOY_HOST_LIST} cred(按主机)=${mapping} user=${env.DEPLOY_USER_RESOLVED} DEPLOY_DIR=${env.EFFECTIVE_DEPLOY_DIR}"
          }
        }
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build') {
      when { expression { env.EFFECTIVE_OPERATE == 'deploy' } }
      steps {
        dir('quickboot') {
          sh 'mvn -pl quickboot-app -am package -DskipTests'
        }
      }
    }

    stage('Archive') {
      when { expression { env.EFFECTIVE_OPERATE == 'deploy' } }
      steps {
        archiveArtifacts artifacts: "${env.TARGET_DIR}/quickboot-app-*.jar", fingerprint: true, excludes: '**/*.jar.original'
      }
    }

    stage('Deploy') {
      when { expression { env.EFFECTIVE_OPERATE == 'deploy' } }
      steps {
        script {
          def localJar = sh(
            script: "ls -1 ${env.TARGET_DIR}/quickboot-app-*.jar | grep -v original | head -n1",
            returnStdout: true
          ).trim()
          if (!localJar) {
            error('未找到可发布的 quickboot-app jar')
          }
          def deployDir = env.EFFECTIVE_DEPLOY_DIR
          def profile = env.EFFECTIVE_SPRING_PROFILE
          def remoteNewJar = "/tmp/${env.JAR_NAME}"
          withEachHost { host, sshOpts ->
            echo "部署到 ${host}:${deployDir}"
            sh """
              set -e
              ssh ${sshOpts} ${env.DEPLOY_USER_RESOLVED}@${host} "mkdir -p '${deployDir}'"
              scp ${sshOpts} deploy/app.sh ${env.DEPLOY_USER_RESOLVED}@${host}:'${deployDir}/app.sh'
              ssh ${sshOpts} ${env.DEPLOY_USER_RESOLVED}@${host} "chmod +x '${deployDir}/app.sh'"
              scp ${sshOpts} '${localJar}' ${env.DEPLOY_USER_RESOLVED}@${host}:'${remoteNewJar}'
              ssh ${sshOpts} ${env.DEPLOY_USER_RESOLVED}@${host} \
                "cd '${deployDir}' && ./app.sh deploy '${remoteNewJar}' --profile '${profile}'"
            """
          }
        }
      }
    }

    stage('Rollback') {
      when { expression { env.EFFECTIVE_OPERATE == 'rollback' } }
      steps {
        script {
          def deployDir = env.EFFECTIVE_DEPLOY_DIR
          def profile = env.EFFECTIVE_SPRING_PROFILE
          withEachHost { host, sshOpts ->
            echo "回滚 ${host}:${deployDir}"
            sh """
              set -e
              ssh ${sshOpts} ${env.DEPLOY_USER_RESOLVED}@${host} "mkdir -p '${deployDir}' '${deployDir}/back'"
              scp ${sshOpts} deploy/app.sh ${env.DEPLOY_USER_RESOLVED}@${host}:'${deployDir}/app.sh'
              ssh ${sshOpts} ${env.DEPLOY_USER_RESOLVED}@${host} "chmod +x '${deployDir}/app.sh'"
              ssh ${sshOpts} ${env.DEPLOY_USER_RESOLVED}@${host} \
                "cd '${deployDir}' && ./app.sh rollback --profile '${profile}'"
            """
          }
        }
      }
    }

    stage('Smoke') {
      steps {
        script {
          if (env.EFFECTIVE_SKIP_SMOKE == 'true') {
            echo 'SKIP_SMOKE=true，跳过冒烟'
            return
          }
          def smokeUrl = "http://127.0.0.1:${env.port}/actuator/health"
          def retries = '5'
          def delaySec = '5'
          withEachHost { host, sshOpts ->
            echo "健康检查 ${host} ${smokeUrl}"
            sh """
              set -e
              ssh ${sshOpts} ${env.DEPLOY_USER_RESOLVED}@${host} '
                url="${smokeUrl}"
                retries=${retries}
                delay=${delaySec}
                i=1
                while [ "\$i" -le "\$retries" ]; do
                  code=\$(curl -s -o /dev/null -w "%{http_code}" "\$url" || echo 000)
                  if [ "\$code" = "200" ]; then
                    echo "健康检查通过 HTTP \$code"
                    exit 0
                  fi
                  echo "等待服务启动... 第 \$i/\$retries 次，HTTP=\$code"
                  i=\$((i + 1))
                  if [ "\$i" -le "\$retries" ]; then
                    sleep "\$delay"
                  fi
                done
                echo "健康检查失败：\$url"
                exit 1
              '
            """
          }
        }
      }
    }
  }

  post {
    success {
      echo "✅ quickboot ${env.EFFECTIVE_OPERATE} 成功 ENV=${env.EFFECTIVE_ENV} BUILD=${env.BUILD_NUMBER}"
    }
    failure {
      echo "❌ quickboot ${env.EFFECTIVE_OPERATE} 失败 ENV=${env.EFFECTIVE_ENV} BUILD=${env.BUILD_NUMBER} 日志=${env.BUILD_URL}"
    }
  }
}

/** 从 Job Configure 读取参数；缺省时用 fallback（仅首次未配置 Job 时兜底）。 */
def validateJobParameters() {
  def missing = []
  ['ENV', 'BRANCH', 'DEPLOY_HOSTS', 'DEPLOY_DIR', 'SPRING_PROFILE', 'operate'].each { name ->
    if (!params.containsKey(name)) {
      missing << name
    }
  }
  if (!missing.isEmpty()) {
    error("Job 未配置参数: ${missing.join(', ')}。请在 Jenkins Job → Configure → 参数化构建过程 中添加，见 deploy/env/README.md")
  }

  env.EFFECTIVE_ENV = paramString('ENV', 'test')
  env.EFFECTIVE_BRANCH = paramString('BRANCH', 'main')
  env.EFFECTIVE_DEPLOY_HOSTS = paramString('DEPLOY_HOSTS', '')
  env.EFFECTIVE_DEPLOY_CRED_ID = paramString('DEPLOY_CRED_ID', '')
  env.EFFECTIVE_DEPLOY_DIR = paramString('DEPLOY_DIR', '/opt/quickboot/app')
  env.EFFECTIVE_SPRING_PROFILE = paramString('SPRING_PROFILE', 'prod')
  env.EFFECTIVE_OPERATE = paramString('operate', 'deploy')
  env.EFFECTIVE_SKIP_SMOKE = paramBool('SKIP_SMOKE', false)

  if (!splitHosts(env.EFFECTIVE_DEPLOY_HOSTS)) {
    error('DEPLOY_HOSTS 不能为空')
  }
}

def paramString(String name, String fallback) {
  if (!params.containsKey(name)) {
    return fallback
  }
  def v = params[name]?.toString()?.trim()
  return v ?: fallback
}

def paramBool(String name, boolean fallback) {
  if (!params.containsKey(name)) {
    return fallback.toString()
  }
  return params[name]?.toString()
}

def splitHosts(String raw) {
  return (raw ?: '').split(/[,;\s]+/).findAll { it }
}

def resolveSshCredId(String host) {
  def override = env.EFFECTIVE_DEPLOY_CRED_ID?.trim()
  return override ?: host
}

def withEachHost(Closure body) {
  def hosts = splitHosts(env.DEPLOY_HOST_LIST)
  def sshOpts = env.QUICKBOOT_SSH_OPTS?.trim() ?: '-o StrictHostKeyChecking=no'
  hosts.each { host ->
    def credId = resolveSshCredId(host)
    echo "SSH 主机=${host} 凭据 ID=${credId}"
    sshagent(credentials: [credId]) {
      body(host, sshOpts)
    }
  }
}
