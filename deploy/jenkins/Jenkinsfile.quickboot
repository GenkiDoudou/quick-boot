/**
 * quickboot 后端发布 Pipeline。
 *
 * DEPLOY_HOSTS = 目标机 IP/域名（逗号分隔）；Jenkins SSH 凭据 ID 与主机名相同。
 * 例：DEPLOY_HOSTS=192.168.50.105 → ssh user@192.168.50.105，凭据 ID=192.168.50.105
 *
 * 参数：当前构建已带 params 则沿用；全部缺失时写入默认参数并提示再构建一次（不读 Job rawBuild，避免沙箱拦截）。
 *
 * 线上 DB/Redis：目标机 ${DEPLOY_DIR}/.env.properties 由运维维护；本 Job 只发 jar。
 * 骨架见 quickboot-app/src/main/resources/.env.properties.example
 */
pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  tools {
    maven 'mvn'
  }

  environment {
    JAR_NAME = 'quickboot-app.jar'
    port = '9993'
    TARGET_DIR = 'quickboot/quickboot-app/target'
  }

  stages {
    stage('Resolve') {
      steps {
        script {
          ensureJobParameters()
          validateJobParameters()
          splitHosts(env.EFFECTIVE_DEPLOY_HOSTS).each { host ->
            echo "ENV=${env.EFFECTIVE_ENV} operate=${env.EFFECTIVE_OPERATE} host=${host} cred=${host} user=${env.DEPLOY_USER_RESOLVED} DEPLOY_DIR=${env.EFFECTIVE_DEPLOY_DIR}"
          }
        }
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build') {
      when { expression { env.EFFECTIVE_OPERATE == 'deploy' } }
      steps {
        dir('quickboot') {
          sh 'mvn -pl quickboot-app -am package -DskipTests'
        }
      }
    }

    stage('Archive') {
      when { expression { env.EFFECTIVE_OPERATE == 'deploy' } }
      steps {
        archiveArtifacts artifacts: "${env.TARGET_DIR}/quickboot-app-*.jar", fingerprint: true, excludes: '**/*.jar.original'
      }
    }

    stage('Deploy') {
      when { expression { env.EFFECTIVE_OPERATE == 'deploy' } }
      steps {
        script {
          def localJar = sh(
            script: "ls -1 ${env.TARGET_DIR}/quickboot-app-*.jar | grep -v original | head -n1",
            returnStdout: true
          ).trim()
          if (!localJar) {
            error('未找到可发布的 quickboot-app jar')
          }
          def deployDir = env.EFFECTIVE_DEPLOY_DIR
          def profile = env.EFFECTIVE_SPRING_PROFILE
          def remoteNewJar = "/tmp/${env.JAR_NAME}"
          withEachHost { host, user, sshOpts ->
            echo "部署到 ${host}:${deployDir} (凭据 ${host})"
            sh """
              set -e
              ssh ${sshOpts} ${user}@${host} "mkdir -p '${deployDir}'"
              if ! ssh ${sshOpts} ${user}@${host} "test -f '${deployDir}/.env.properties'"; then
                echo "警告: ${host}:${deployDir}/.env.properties 不存在。请先按 deploy/env/.env.properties.example 放置后再发版。" >&2
              fi
              scp ${sshOpts} deploy/app.sh ${user}@${host}:'${deployDir}/app.sh'
              ssh ${sshOpts} ${user}@${host} "chmod +x '${deployDir}/app.sh'"
              scp ${sshOpts} '${localJar}' ${user}@${host}:'${remoteNewJar}'
              ssh ${sshOpts} ${user}@${host} \
                "cd '${deployDir}' && ./app.sh deploy '${remoteNewJar}' --profile '${profile}'"
            """
          }
        }
      }
    }

    stage('Rollback') {
      when { expression { env.EFFECTIVE_OPERATE == 'rollback' } }
      steps {
        script {
          def deployDir = env.EFFECTIVE_DEPLOY_DIR
          def profile = env.EFFECTIVE_SPRING_PROFILE
          withEachHost { host, user, sshOpts ->
            echo "回滚 ${host}:${deployDir} (凭据 ${host})"
            sh """
              set -e
              ssh ${sshOpts} ${user}@${host} "mkdir -p '${deployDir}' '${deployDir}/back'"
              scp ${sshOpts} deploy/app.sh ${user}@${host}:'${deployDir}/app.sh'
              ssh ${sshOpts} ${user}@${host} "chmod +x '${deployDir}/app.sh'"
              ssh ${sshOpts} ${user}@${host} \
                "cd '${deployDir}' && ./app.sh rollback --profile '${profile}'"
            """
          }
        }
      }
    }

    stage('Smoke') {
      steps {
        script {
          if (env.EFFECTIVE_SKIP_SMOKE == 'true') {
            echo 'SKIP_SMOKE=true，跳过冒烟'
            return
          }
          def smokeUrl = "http://127.0.0.1:${env.port}/actuator/health"
          def retries = '10'
          def delaySec = '30'
          withEachHost { host, user, sshOpts ->
            echo "健康检查 ${host} ${smokeUrl}"
            sh """
              set -e
              ssh ${sshOpts} ${user}@${host} '
                url="${smokeUrl}"
                retries=${retries}
                delay=${delaySec}
                i=1
                while [ "\$i" -le "\$retries" ]; do
                  code=\$(curl -s -o /dev/null -w "%{http_code}" "\$url" || echo 000)
                  if [ "\$code" = "200" ]; then
                    echo "健康检查通过 HTTP \$code"
                    exit 0
                  fi
                  echo "等待服务启动... 第 \$i/\$retries 次，HTTP=\$code"
                  i=\$((i + 1))
                  if [ "\$i" -le "\$retries" ]; then
                    sleep "\$delay"
                  fi
                done
                echo "健康检查失败：\$url"
                exit 1
              '
            """
          }
        }
      }
    }
  }

  post {
    success {
      echo "✅ quickboot ${env.EFFECTIVE_OPERATE} 成功 ENV=${env.EFFECTIVE_ENV} BUILD=${env.BUILD_NUMBER}"
    }
    failure {
      echo "❌ quickboot ${env.EFFECTIVE_OPERATE} 失败 ENV=${env.EFFECTIVE_ENV} BUILD=${env.BUILD_NUMBER} 日志=${env.BUILD_URL}"
    }
  }
}

def requiredJobParamNames() {
  return ['ENV', 'BRANCH', 'DEPLOY_HOSTS', 'DEPLOY_DIR', 'SPRING_PROFILE', 'operate']
}

def defaultJobParameters() {
  return [
    choice(name: 'ENV', choices: ['test', 'prod', 'dev'], description: '部署环境标识'),
    string(name: 'BRANCH', defaultValue: 'main', description: 'Git 分支'),
    string(name: 'DEPLOY_HOSTS', defaultValue: '', description: '目标机 IP/域名，逗号分隔；Jenkins SSH 凭据 ID 须与主机名相同'),
    string(name: 'DEPLOY_DIR', defaultValue: '/opt/quickboot/app', description: '目标机部署目录'),
    string(name: 'SPRING_PROFILE', defaultValue: 'prod', description: 'Spring profile，传给 app.sh --profile'),
    choice(name: 'operate', choices: ['deploy', 'rollback'], description: 'deploy=发布 rollback=回滚'),
    booleanParam(name: 'SKIP_SMOKE', defaultValue: false, description: '跳过健康检查'),
  ]
}

/**
 * 仅根据当前构建 params 判断：齐全则跳过；全部缺失则写入默认参数；部分缺失则报错提示手工补。
 * 不访问 rawBuild，避免 Script Security 拦截。
 */
def ensureJobParameters() {
  def required = requiredJobParamNames()
  def missing = required.findAll { !params.containsKey(it) }

  if (missing.isEmpty()) {
    echo '使用当前构建参数（不覆盖 Job Configure）'
    return
  }

  if (missing.size() < required.size()) {
    error("Job 缺少部分参数: ${missing.join(', ')}。请在 Configure → 参数化构建过程 手工添加；或删除全部参数后重新构建以自动初始化。见 deploy/env/README.md")
  }

  echo 'Job 尚未带入必需参数，正在写入默认参数定义（仅此一次）…'
  properties([parameters(defaultJobParameters())])
  error('已在 Job 中写入默认参数。请再次点击「Build with Parameters」开始构建（可在 Configure 修改默认值）。')
}

def validateJobParameters() {
  def missing = requiredJobParamNames().findAll { !params.containsKey(it) }
  if (!missing.isEmpty()) {
    error("当前构建未带入参数: ${missing.join(', ')}。请使用「Build with Parameters」。")
  }

  env.EFFECTIVE_ENV = paramString('ENV', 'test')
  env.EFFECTIVE_BRANCH = paramString('BRANCH', 'main')
  env.EFFECTIVE_DEPLOY_HOSTS = paramString('DEPLOY_HOSTS', '')
  env.EFFECTIVE_DEPLOY_DIR = paramString('DEPLOY_DIR', '/opt/quickboot/app')
  env.EFFECTIVE_SPRING_PROFILE = paramString('SPRING_PROFILE', 'prod')
  env.EFFECTIVE_OPERATE = paramString('operate', 'deploy')
  env.EFFECTIVE_SKIP_SMOKE = paramBool('SKIP_SMOKE', false)
  env.DEPLOY_USER_RESOLVED = env.QUICKBOOT_SSH_USER?.trim() ?: 'root'

  def hosts = splitHosts(env.EFFECTIVE_DEPLOY_HOSTS)
  if (!hosts) {
    error('DEPLOY_HOSTS 不能为空（填写目标机 IP/域名，且 Jenkins 凭据 ID 与之相同）')
  }
  hosts.each { host ->
    if (host ==~ /^\d+$/) {
      error("DEPLOY_HOSTS 项「${host}」无效（像端口号）。请填完整 IP/域名，例如 192.168.50.105")
    }
  }
}

def paramString(String name, String fallback) {
  if (!params.containsKey(name)) {
    return fallback
  }
  def v = params[name]?.toString()?.trim()
  return v ?: fallback
}

def paramBool(String name, boolean fallback) {
  if (!params.containsKey(name)) {
    return fallback.toString()
  }
  return params[name]?.toString()
}

def splitHosts(String raw) {
  return (raw ?: '').split(/[,;\s]+/).findAll { it }
}

/** 对每台主机：凭据 ID = 主机名。 */
def withEachHost(Closure body) {
  def sshOpts = env.QUICKBOOT_SSH_OPTS?.trim() ?: '-o StrictHostKeyChecking=no'
  def user = env.DEPLOY_USER_RESOLVED
  splitHosts(env.EFFECTIVE_DEPLOY_HOSTS).each { host ->
    echo "SSH 目标=${host} 用户=${user} 凭据 ID=${host}"
    sshagent(credentials: [host]) {
      body(host, user, sshOpts)
    }
  }
}
