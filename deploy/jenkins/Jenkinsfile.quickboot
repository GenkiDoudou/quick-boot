/**
 * quickboot 后端发布 Pipeline。
 * Job 建议名：deploy-quickboot；Script Path：deploy/jenkins/Jenkinsfile.quickboot
 *
 * 每次构建：ENV、BRANCH；可选覆盖 DEPLOY_HOSTS。
 * Job/全局可配：主机列表、目录、凭据 ID、冒烟 URL。详见 deploy/env/README.md
 */
pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  tools {
    maven 'mvn'
  }

  parameters {
    choice(name: 'ENV', choices: ['test', 'prod'], description: '目标环境（用于选凭据与默认主机列表）')
    string(name: 'BRANCH', defaultValue: 'main', description: 'Git 分支')
    string(name: 'DEPLOY_HOSTS', defaultValue: '', description: '目标机，逗号分隔；空则用环境变量 QUICKBOOT_HOSTS_TEST/PROD 或 QUICKBOOT_HOST_TEST/PROD')
    string(name: 'DEPLOY_DIR', defaultValue: '/opt/quickboot/app', description: '远程 jar 安装目录')
    string(name: 'JAR_NAME', defaultValue: 'quickboot-app.jar', description: '远程 jar 文件名')
    string(name: 'SERVICE_NAME', defaultValue: 'quickboot', description: 'systemd 单元名（不含 .service）')
    string(name: 'DEPLOY_USER', defaultValue: '', description: 'SSH 与运行用户；空则 QUICKBOOT_SSH_USER 或 quickboot')
    string(name: 'CONFIG_DIR', defaultValue: '/opt/quickboot/config', description: '远程 Spring 外部配置目录（不覆盖已有 yml）')
    string(name: 'SMOKE_LOCAL_URL', defaultValue: 'http://127.0.0.1:9993/actuator/health', description: '每台目标机上 SSH curl 的完整 URL；空则跳过实例探活')
    string(name: 'SMOKE_BASE_URL', defaultValue: '', description: '可选，公网完整探活 URL（不再自动拼接路径）')
    booleanParam(name: 'SKIP_SMOKE', defaultValue: false, description: '跳过全部冒烟')
  }

  stages {
    stage('Resolve ENV') {
      steps {
        script {
          def meta = resolveDeployMeta()
          env.DEPLOY_CRED_ID = meta.credId
          env.DEPLOY_USER_RESOLVED = meta.user
          env.DEPLOY_HOST_LIST = meta.hosts.join(',')
          echo "ENV=${params.ENV} hosts=${env.DEPLOY_HOST_LIST} cred=${env.DEPLOY_CRED_ID} user=${env.DEPLOY_USER_RESOLVED}"
        }
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
        sh "git fetch --all --prune && git checkout ${params.BRANCH}"
      }
    }

    stage('Build') {
      steps {
        dir('quickboot') {
          sh 'mvn -pl quickboot-app -am package -DskipTests'
        }
      }
    }

    stage('Archive') {
      steps {
        archiveArtifacts artifacts: 'quickboot/quickboot-app/target/quickboot-app-*.jar', fingerprint: true, excludes: '**/*.jar.original'
      }
    }

    stage('Deploy') {
      steps {
        script {
          def localJar = sh(
            script: "ls -1 quickboot/quickboot-app/target/quickboot-app-*.jar | grep -v original | head -n1",
            returnStdout: true
          ).trim()
          if (!localJar) {
            error('未找到可发布的 quickboot-app jar')
          }
          def hosts = splitHosts(env.DEPLOY_HOST_LIST)
          def sshOpts = env.QUICKBOOT_SSH_OPTS?.trim() ?: '-o StrictHostKeyChecking=no'
          def remoteJar = "/tmp/${params.JAR_NAME}.new"
          def remoteScript = '/tmp/remote-deploy-jar.sh'
          sshagent(credentials: [env.DEPLOY_CRED_ID]) {
            hosts.each { host ->
              echo "部署到 ${host}"
              sh """
                set -e
                scp ${sshOpts} '${localJar}' ${env.DEPLOY_USER_RESOLVED}@${host}:${remoteJar}
                scp ${sshOpts} deploy/scripts/remote-deploy-jar.sh ${env.DEPLOY_USER_RESOLVED}@${host}:${remoteScript}
                ssh ${sshOpts} ${env.DEPLOY_USER_RESOLVED}@${host} \
                  "sudo env \
                    NEW_JAR='${remoteJar}' \
                    DEPLOY_DIR='${params.DEPLOY_DIR}' \
                    JAR_NAME='${params.JAR_NAME}' \
                    SERVICE_NAME='${params.SERVICE_NAME}' \
                    RUN_USER='${env.DEPLOY_USER_RESOLVED}' \
                    CONFIG_DIR='${params.CONFIG_DIR}' \
                    bash ${remoteScript}"
              """
            }
          }
        }
      }
    }

    stage('Smoke') {
      steps {
        script {
          if (params.SKIP_SMOKE) {
            echo 'SKIP_SMOKE=true，跳过冒烟'
            return
          }
          def sshOpts = env.QUICKBOOT_SSH_OPTS?.trim() ?: '-o StrictHostKeyChecking=no'
          def hosts = splitHosts(env.DEPLOY_HOST_LIST)
          def localUrl = params.SMOKE_LOCAL_URL?.trim()
          sshagent(credentials: [env.DEPLOY_CRED_ID]) {
            if (localUrl) {
              hosts.each { host ->
                echo "实例探活 ${host} ${localUrl}"
                sh """
                  ssh ${sshOpts} ${env.DEPLOY_USER_RESOLVED}@${host} \
                    "curl -sf --retry 5 --retry-delay 3 '${localUrl}'"
                """
              }
            }
          }
          def publicUrl = params.SMOKE_BASE_URL?.trim()
          if (publicUrl) {
            echo "入口探活 ${publicUrl}"
            sh "curl -sf --retry 5 --retry-delay 3 '${publicUrl}'"
          }
          if (!localUrl && !publicUrl) {
            echo '未配置 SMOKE_LOCAL_URL / SMOKE_BASE_URL，跳过冒烟'
          }
        }
      }
    }
  }
}

/**
 * 解析主机列表、SSH 用户与凭据。
 * DEPLOY_HOSTS 优先；否则 QUICKBOOT_HOSTS_*（逗号分隔）或旧变量 QUICKBOOT_HOST_*。
 */
def resolveDeployMeta() {
  def user = params.DEPLOY_USER?.trim() ?: env.QUICKBOOT_SSH_USER?.trim() ?: 'quickboot'
  def hostsOverride = params.DEPLOY_HOSTS?.trim()
  def credTest = env.DEPLOY_CRED_TEST?.trim() ?: 'deploy-test'
  def credProd = env.DEPLOY_CRED_PROD?.trim() ?: 'deploy-prod'
  def credId
  def hostsRaw
  switch (params.ENV) {
    case 'test':
      credId = credTest
      hostsRaw = hostsOverride ?: env.QUICKBOOT_HOSTS_TEST?.trim() ?: env.QUICKBOOT_HOST_TEST?.trim()
      if (!hostsRaw) { error('请填写参数 DEPLOY_HOSTS，或配置 QUICKBOOT_HOSTS_TEST / QUICKBOOT_HOST_TEST') }
      break
    case 'prod':
      credId = credProd
      hostsRaw = hostsOverride ?: env.QUICKBOOT_HOSTS_PROD?.trim() ?: env.QUICKBOOT_HOST_PROD?.trim()
      if (!hostsRaw) { error('请填写参数 DEPLOY_HOSTS，或配置 QUICKBOOT_HOSTS_PROD / QUICKBOOT_HOST_PROD') }
      break
    default:
      error("未知 ENV: ${params.ENV}，仅支持 test|prod")
  }
  def hosts = splitHosts(hostsRaw)
  if (hosts.isEmpty()) {
    error('主机列表为空')
  }
  return [credId: credId, user: user, hosts: hosts]
}

/** 逗号/空白分隔主机名，去掉空项。 */
def splitHosts(String raw) {
  return (raw ?: '').split(/[,;\s]+/).findAll { it }
}
