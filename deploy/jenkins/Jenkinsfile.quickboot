/**
 * quickboot 后端发布 Pipeline。
 * Job 建议名：deploy-quickboot；Script Path：deploy/jenkins/Jenkinsfile.quickboot
 *
 * 远程用 deploy/app.sh（nohup）。固定 JAR_NAME / port；参数见下方 parameters。
 */
 // 全局 Git 超时，单位：分钟
 System.setProperty("org.jenkinsci.plugins.gitclient.Git.timeOut", "60")
pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  tools {
    maven 'mvn'
  }

  // 定义变量（非构建参数）
  environment {
    // 应用 jar 名称
    JAR_NAME = 'quickboot-app.jar'
    // 应用端口，用于健康检查
    port = '9993'
  }

  parameters {
    choice(name: 'ENV', choices: ['test', 'prod', 'dev'], description: '环境（映射 SSH 凭据 deploy-${ENV}）')
    string(name: 'BRANCH', defaultValue: 'main', description: 'Git 分支')
    string(name: 'DEPLOY_HOSTS', defaultValue: '', description: '部署机，多个用英文逗号分隔')
    string(name: 'DEPLOY_DIR', defaultValue: '/opt/quickboot/app', description: '部署目录（唯一 jar + app.sh）')
    string(name: 'SPRING_PROFILE', defaultValue: 'prod', description: '传给 app.sh --profile')
    choice(name: 'operate', choices: ['deploy', 'rollback'], description: '操作：部署或回滚')
    booleanParam(name: 'SKIP_SMOKE', defaultValue: false, description: '跳过全部冒烟')
  }

  stages {
    stage('Resolve') {
      steps {
        script {
          def hosts = splitHosts(params.DEPLOY_HOSTS)
          if (hosts.isEmpty()) {
            error('请填写参数 DEPLOY_HOSTS（多个主机用逗号分隔）')
          }
          env.DEPLOY_HOST_LIST = hosts.join(',')
          env.DEPLOY_USER_RESOLVED = env.QUICKBOOT_SSH_USER?.trim() ?: 'quickboot'
          // 凭据 ID：deploy-test / deploy-prod / deploy-dev，可用 DEPLOY_CRED_<ENV> 覆盖
          def envKey = params.ENV.toUpperCase()
          env.DEPLOY_CRED_ID = env."DEPLOY_CRED_${envKey}"?.trim() ?: "deploy-${params.ENV}"
          echo "ENV=${params.ENV} operate=${params.operate} hosts=${env.DEPLOY_HOST_LIST} cred=${env.DEPLOY_CRED_ID} user=${env.DEPLOY_USER_RESOLVED}"
        }
      }
    }

    stage('Checkout') {
      steps {
        checkout scm

      }
    }

    stage('Build') {
      when { expression { params.operate == 'deploy' } }
      steps {
        dir('quickboot') {
          sh 'mvn -pl quickboot-app -am package -DskipTests'
        }
      }
    }

    stage('Archive') {
      when { expression { params.operate == 'deploy' } }
      steps {
        archiveArtifacts artifacts: 'quickboot/quickboot-app/target/quickboot-app-*.jar', fingerprint: true, excludes: '**/*.jar.original'
      }
    }

    stage('Deploy') {
      when { expression { params.operate == 'deploy' } }
      steps {
        script {
          def localJar = sh(
            script: "ls -1 quickboot/quickboot-app/target/quickboot-app-*.jar | grep -v original | head -n1",
            returnStdout: true
          ).trim()
          if (!localJar) {
            error('未找到可发布的 quickboot-app jar')
          }
          def hosts = splitHosts(env.DEPLOY_HOST_LIST)
          def sshOpts = env.QUICKBOOT_SSH_OPTS?.trim() ?: '-o StrictHostKeyChecking=no'
          def deployDir = params.DEPLOY_DIR
          def jarName = env.JAR_NAME
          def profile = params.SPRING_PROFILE
          sshagent(credentials: [env.DEPLOY_CRED_ID]) {
            hosts.each { host ->
              echo "部署到 ${host}:${deployDir}"
              sh """
                set -e
                ssh ${sshOpts} ${env.DEPLOY_USER_RESOLVED}@${host} "mkdir -p '${deployDir}' '${deployDir}/back'"
                scp ${sshOpts} deploy/app.sh ${env.DEPLOY_USER_RESOLVED}@${host}:'${deployDir}/app.sh'
                ssh ${sshOpts} ${env.DEPLOY_USER_RESOLVED}@${host} "chmod +x '${deployDir}/app.sh'"
                ssh ${sshOpts} ${env.DEPLOY_USER_RESOLVED}@${host} '
                  set -e
                  cd "${deployDir}"
                  if [ -x ./app.sh ]; then
                    ./app.sh stop || true
                  fi
                  if ls -1 ./*.jar >/dev/null 2>&1; then
                    mkdir -p back
                    stamp=\$(date +%Y%m%d%H%M%S)
                    for j in ./*.jar; do
                      bn=\$(basename "\$j")
                      cp "\$j" "back/\${bn}.\${stamp}"
                      echo "已备份 \$j -> back/\${bn}.\${stamp}"
                    done
                    rm -f ./*.jar
                  fi
                '
                scp ${sshOpts} '${localJar}' ${env.DEPLOY_USER_RESOLVED}@${host}:'${deployDir}/${jarName}'
                ssh ${sshOpts} ${env.DEPLOY_USER_RESOLVED}@${host} \
                  "cd '${deployDir}' && ./app.sh start --profile '${profile}'"
              """
            }
          }
        }
      }
    }

    stage('Rollback') {
      when { expression { params.operate == 'rollback' } }
      steps {
        script {
          def hosts = splitHosts(env.DEPLOY_HOST_LIST)
          def sshOpts = env.QUICKBOOT_SSH_OPTS?.trim() ?: '-o StrictHostKeyChecking=no'
          def deployDir = params.DEPLOY_DIR
          def profile = params.SPRING_PROFILE
          sshagent(credentials: [env.DEPLOY_CRED_ID]) {
            hosts.each { host ->
              echo "回滚 ${host}:${deployDir}"
              sh """
                set -e
                ssh ${sshOpts} ${env.DEPLOY_USER_RESOLVED}@${host} "mkdir -p '${deployDir}' '${deployDir}/back'"
                scp ${sshOpts} deploy/app.sh ${env.DEPLOY_USER_RESOLVED}@${host}:'${deployDir}/app.sh'
                ssh ${sshOpts} ${env.DEPLOY_USER_RESOLVED}@${host} "chmod +x '${deployDir}/app.sh'"
                ssh ${sshOpts} ${env.DEPLOY_USER_RESOLVED}@${host} \
                  "cd '${deployDir}' && ./app.sh rollback --profile '${profile}'"
              """
            }
          }
        }
      }
    }

    stage('Smoke') {
      steps {
        script {
          if (params.SKIP_SMOKE) {
            echo 'SKIP_SMOKE=true，跳过冒烟'
            return
          }
          def sshOpts = env.QUICKBOOT_SSH_OPTS?.trim() ?: '-o StrictHostKeyChecking=no'
          def hosts = splitHosts(env.DEPLOY_HOST_LIST)
          def smokeUrl = "http://127.0.0.1:${env.port}/actuator/health"
          def retries = '5'
          def delaySec = '5'
          sshagent(credentials: [env.DEPLOY_CRED_ID]) {
            hosts.each { host ->
              echo "健康检查 ${host} ${smokeUrl}"
              sh """
                set -e
                ssh ${sshOpts} ${env.DEPLOY_USER_RESOLVED}@${host} '
                  url="${smokeUrl}"
                  retries=${retries}
                  delay=${delaySec}
                  i=1
                  while [ "\$i" -le "\$retries" ]; do
                    code=\$(curl -s -o /dev/null -w "%{http_code}" "\$url" || echo 000)
                    if [ "\$code" = "200" ]; then
                      echo "健康检查通过 HTTP \$code"
                      exit 0
                    fi
                    echo "等待服务启动... 第 \$i/\$retries 次，HTTP=\$code"
                    i=\$((i + 1))
                    if [ "\$i" -le "\$retries" ]; then
                      sleep "\$delay"
                    fi
                  done
                  echo "健康检查失败：\$url"
                  exit 1
                '
              """
            }
          }
        }
      }
    }
  }

  post {
    success {
      echo "✅ quickboot ${params.operate} 成功 ENV=${params.ENV} BUILD=${env.BUILD_NUMBER}"
    }
    failure {
      echo "❌ quickboot ${params.operate} 失败 ENV=${params.ENV} BUILD=${env.BUILD_NUMBER} 日志=${env.BUILD_URL}"
    }
  }
}

/** 逗号/空白分隔主机名，去掉空项。 */
def splitHosts(String raw) {
  return (raw ?: '').split(/[,;\s]+/).findAll { it }
}
